# WRECK environment variables.
# Copy to .env.local for development. Nothing here is required to run locally:
# with no Supabase vars the app uses durable local JSON persistence, and with
# no Anthropic key the AI coach uses its deterministic explanation engine.

# --- Auth ---
# Required in production. A long random string used to sign session JWTs.
# Generate one with: openssl rand -base64 48
AUTH_SECRET=

# --- Database (production) ---
# When both are set, WRECK persists to Supabase/Postgres instead of local JSON.
# The service-role key is server-only and must never be exposed to the client.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Google sign-in (optional) ---
# When both are set, a "Continue with Google" button appears on the auth screens.
# Create an OAuth 2.0 Client ID (type: Web application) in Google Cloud Console
# and register this authorized redirect URI (swap in your domain):
#   https://your-domain.com/api/auth/google/callback
# For local dev also add: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- AI coach (optional) ---
# When set, the coach rephrases its grounded answers with Google Gemini. Without
# it, the deterministic coach still answers using your real profile and logs.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model override (defaults to gemini-3.8-flash).
COACH_MODEL=

# --- Photo food logging (optional) ---
# Uses Anthropic (Claude) — it needs vision plus the web_search server tool,
# which is Claude-specific, so this stays separate from the Gemini coach above.
# Without a key, photo capture still works and saves your photos; you just enter
# the numbers manually. Defaults to claude-sonnet-5-5.
ANTHROPIC_API_KEY=
FOOD_SCAN_MODEL=
